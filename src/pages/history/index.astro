---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Card from '../../components/Card.astro';

const entries = (await getCollection('history')).sort((a, b) => a.data.order - b.data.order);

const slugMap: Record<string,string> = {
  "ladies-club-champions": "Ladies' Club Champions",
  "mens-club-champions": "Men's Club Champions",
  "seniors-club-champions": "Seniors Club Champions",
  "alcc-aces": "ALCC Aces",
  "course-record": "Course Record",
  "twilight-league": "Twilight League",
  "prominent-individuals": "Prominent Individuals in ALCC History",
  "route-22-cup": "Route 22 Cup",
};

const milestones = [
  { year: "1924", title: "The idea takes shape", text: "R.P.M. Davis helps organize the Juniata Valley project. Tom Bendelow inspects the land and finds it suitable for an 18-hole course." },
  { year: "1927", title: "The clubhouse opens", text: "The clubhouse formally opens on August 12. The first nine holes are already in play, with work underway on the second nine." },
  { year: "1936", title: "Flood and recovery", text: "The St. Patrick's Day flood devastates the riverside cottage colony and destroys much of the club's documentary record." },
  { year: "1938", title: "The Legion era begins", text: "The Home Association of Simpson-Hunt Post 107 purchases the property at a trustee sale and begins a family-recreation program." },
  { year: "1947", title: "The clubhouse grows", text: "A major clubhouse addition opens as membership and activity increase after World War II." },
  { year: "1975", title: "A new invitational", text: "The first two-person amateur best-ball event launches the tradition now known as the June Invitational." },
];
---

<BaseLayout title="History" description="The source-based history of American Legion Country Club, organized in 1924 as the Juniata Valley Colony Club and summer colony.">
  <PageHero title="History" subtitle="From the Juniata Valley Colony Club to American Legion Country Club — a century of Pennsylvania golf." />

  <section class="section">
    <div class="container narrative">
      <span class="eyebrow">Organized in 1924 · Clubhouse opened in 1927</span>
      <p>In the heart of Pennsylvania's Juniata Valley, the story of American
      Legion Country Club unfolds as one of vision, collaboration, and
      community. It began on August 26, 1924, when R.P.M. Davis, a retired
      banker and manufacturer, called a meeting at Mount Union High School to
      launch a country club and summer colony. A contemporary report counted
      128 stockholders and charter members and described an initial 300-acre
      tract with roughly two miles of Juniata River frontage: the Walter
      Gifford farm, formerly the Cowden farm, purchased from Hercules Powder
      Company.</p>

      <p>The development grew in stages. By 1926, reports described a much
      larger tract assembled from several farms, along with roads, utilities,
      cottages, a clubhouse under construction, and plans for golf, swimming,
      tennis, boating, fishing, and trapshooting. The clubhouse formally opened
      on August 12, 1927. The first nine holes were already in use, while work
      continued on the second nine. A 1931 report credited grounds
      superintendent William H. Griffith with constructing the last nine.</p>

      <p>The St. Patrick's Day Flood of 1936 devastated the riverside cottage
      colony and destroyed club records, but activity continued. A 1936 trustee
      sale became the subject of litigation and was later set aside. Contemporary
      coverage places the American Legion purchase in April 1938, followed by a
      development program centered on affordable family recreation. Membership
      grew after World War II, prompting a clubhouse addition in 1947.</p>

      <p>The club's legacy is tied to two names in particular: golf course
      architect <a href="/history/prominent-individuals">Tom Bendelow</a>,
      whose 1924 inspection letter found the land suitable for 18 holes, and
      <a href="/history/prominent-individuals">Anna Wagner Keichline</a>,
      the pioneering architect who designed the main clubhouse building.</p>

      <div class="gallery grid grid--3">
        <figure>
          <img src="/images/history/jvcc-seal.webp" alt="Juniata Valley Colony Club seal and property map" loading="lazy" />
          <figcaption>The original Juniata Valley Colony Club seal and property map.</figcaption>
        </figure>
        <figure>
          <img src="/images/history/clubhouse-construction.webp" alt="Juniata Valley Colony Club clubhouse under construction in the 1920s" loading="lazy" />
          <figcaption>The clubhouse under construction; newspaper reporting places work underway by August 1926.</figcaption>
        </figure>
        <figure>
          <img src="/images/history/1936-flood.webp" alt="The 1936 St. Patrick's Day Flood" loading="lazy" />
          <figcaption>Damage from the 1936 St. Patrick's Day Flood.</figcaption>
        </figure>
      </div>

      <div class="history-actions">
        <a class="btn btn--red" href="/history/colony-club-story">Read the Deep History</a>
        <a class="btn btn--navy" href="/history/club-timeline">Explore the Full Timeline</a>
        <a class="btn btn--navy" href="/history/archive">Browse the Historical Archive</a>
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container">
      <span class="eyebrow eyebrow--gold">A Century on the Same Ground</span>
      <h2>Key Moments in the Club and Course Story</h2>
      <div class="milestone-grid">
        {milestones.map((item) => (
          <article class="milestone-card">
            <span class="milestone-card__year">{item.year}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--off-white">
    <div class="container">
      <span class="eyebrow">Explore</span>
      <h2>Records &amp; Notable Figures</h2>
      <div class="grid grid--3">
        {entries.map((e) => (
          <Card
            title={slugMap[e.slug] ?? e.data.title}
            href={`/history/${e.slug}`}
            description={e.data.summary}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrative { max-width: 780px; }
  .gallery { margin-top: 2.5rem; }
  .gallery figure { margin: 0; }
  .gallery img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius); }
  .gallery figcaption { font-size: 0.85rem; color: var(--color-gray); margin-top: 0.5rem; }
  .history-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .eyebrow--gold { color: #ffd966; }
  .milestone-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 1.5rem; }
  .milestone-card { border-top: 3px solid var(--color-red); padding-top: 1rem; }
  .milestone-card__year { color: #ffd966; display: block; font-family: var(--font-heading); font-size: 1.7rem; font-weight: 700; line-height: 1; margin-bottom: 0.5rem; }
  .milestone-card h3 { color: var(--color-white); font-size: 1.05rem; }
  .milestone-card p { color: rgba(255,255,255,0.82); font-size: 0.92rem; margin: 0; }
  @media (max-width: 850px) { .milestone-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .milestone-grid { grid-template-columns: 1fr; } }
</style>
