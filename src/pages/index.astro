---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';

const announcements = [
  { text: "Temporary daily golf rates now in effect due to current green conditions", href: "/rates" },
  { text: "Golf Committee rifle raffle — only 50 chances available", href: "#rifle-raffle" },
  { text: "Membership applications available for the 2026 season", href: "/memberships" },
  { text: "2026 tournament schedule is available through our Events portal", href: "/events" },
  { text: "Central Counties events for 2026 are scheduled — see the CCGA page", href: "/events/central-counties" },
  { text: "Interested in using ALCC as a venue? Contact Barry at (814) 542-4343", href: "/contact" },
];

const quickLinks = [
  { title: "Golf", href: "/golf-course", description: "18 holes of classic Pennsylvania golf.", image: "/images/golf-course/course-1.webp" },
  { title: "Lounge", href: "/stonehouse-lounge", description: "The StoneHouse Lounge — food and drink with a view of the course.", image: "/images/lounge/stonehouse-logo.webp", imageFit: "contain", imageScale: 0.95 },
  { title: "History", href: "/history", description: "Decades of champions, records, and club lore.", image: "/images/history/colony-club-fairway-7.webp" },
  { title: "Spring Classic", href: "/events/spring-classic", description: "The season-opening team event.", image: "/images/spring-classic/logo.webp", imageFit: "contain" },
  { title: "Central Counties", href: "/events/central-counties", description: "CCGA series events hosted at ALCC.", image: "/images/central-counties/logo.webp", imageFit: "contain" },
  { title: "June Invitational", href: "/events/june-invitational", description: "A longstanding flighted stroke-play invitational.", image: "/images/june-invitational/2027.webp", imageFit: "contain" },
];
---

<BaseLayout title="Home" description="American Legion Country Club — golf course, StoneHouse Lounge, and event venue in Mount Union, PA.">
  <Hero
    eyebrow="Mount Union, Pennsylvania"
    title="Welcome to the American Legion Country Club"
    subtitle="Home to a century of Pennsylvania golf tradition."
    ctaLabel="See All Upcoming Events"
    ctaHref="/events"
    image="/images/home/hero-painting.webp"
  />

  <div class="announcement-bar">
    <div class="container">
      <ul class="announcement-bar__list">
        {announcements.map((a) => (
          <li><a href={a.href}>{a.text}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <section id="rifle-raffle" class="section section--off-white raffle">
    <div class="container raffle__inner">
      <div class="raffle__content">
        <span class="eyebrow">Golf Committee Fundraiser</span>
        <h2>Weatherby Vanguard 300 Rifle Raffle</h2>
        <p class="raffle__lead">Take a chance to win a legendary hunting rifle while supporting the ALCC Golf Committee.</p>
        <dl class="raffle__details">
          <div>
            <dt>Chance Price</dt>
            <dd>$20 each</dd>
          </div>
          <div>
            <dt>Total Chances</dt>
            <dd>Only 50</dd>
          </div>
          <div>
            <dt>Drawing</dt>
            <dd>After all chances are sold</dd>
          </div>
        </dl>
        <p>Purchase a chance with cash at the Pro Shop or from any Golf Committee member, through Venmo at <strong>@ALCCMU</strong>, or through PayPal at <strong>golf.alcc@gmail.com</strong>.</p>
        <p class="raffle__note">The winner will be selected live on the ALCC Facebook page and contacted directly. You do not need to be present to win.</p>
        <a class="btn btn--red" href="/downloads/golf-committee-rifle-raffle.pdf" target="_blank" rel="noopener">View the Full Raffle Flyer</a>
      </div>
      <a class="raffle__art" href="/downloads/golf-committee-rifle-raffle.pdf" target="_blank" rel="noopener" aria-label="Open the full Weatherby Vanguard 300 rifle raffle flyer">
        <img src="/images/home/weatherby-rifle-raffle.jpg" alt="Weatherby Vanguard 300 rifle raffle: $20 per chance, 50 chances total" loading="lazy" />
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Explore the Club</span>
      <h2>Golf, Lounge & History</h2>
      <div class="grid grid--3">
        {quickLinks.map((q) => (
          <Card title={q.title} href={q.href} description={q.description} image={q.image} imageFit={q.imageFit} imageScale={q.imageScale} />
        ))}
      </div>
    </div>
  </section>

  <section class="weather-bar">
    <div class="weather-bar__inner">
      <span class="weather-bar__label">Course Conditions — Mount Union, PA</span>
      <div class="weather-bar__widget">
        <a class="weatherwidget-io" href="https://forecast7.com/en/40d38n77d88/mount-union/?unit=us" data-label_1="MOUNT UNION" data-label_2="PENNSYLVANIA" data-theme="original">MOUNT UNION</a>
      </div>
    </div>
  </section>
  <script is:inline>!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src='https://weatherwidget.io/js/widget.min.js';fjs.parentNode.insertBefore(js,fjs);}}(document,'script','weatherwidget-io-js');</script>

  <section class="section section--navy">
    <div class="container leadership">
      <div>
        <span class="eyebrow eyebrow--light">Club Leadership</span>
        <h2>Who Runs ALCC</h2>
        <ul class="leadership__list">
          <li><strong>Interim General Manager:</strong> Barry Heffelfinger</li>
          <li><strong>Lounge Manager:</strong> Brandi Smith</li>
          <li><strong>Superintendent:</strong> Paul Smith</li>
          <li><strong>Major Tournament Director:</strong> Bruce Smith</li>
        </ul>
      </div>
      <div class="leadership__cta">
        <p>Questions about tee times, membership, or booking the club for an event?</p>
        <a class="btn btn--red" href="tel:18145424343">Call Now: (814) 542-4343</a>
        <a class="btn btn--outline" href="/contact">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .weather-bar {
    background: var(--color-off-white);
    border-top: 1px solid var(--color-gray-light);
    border-bottom: 1px solid var(--color-gray-light);
    padding: 1.25rem 0;
  }
  .weather-bar__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .weather-bar__label {
    display: block;
    text-align: center;
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--color-blue-dark);
    margin-bottom: 0.75rem;
  }
  .weather-bar__widget { width: 100%; }
  .weather-bar__widget :global(.weatherwidget-io) { width: 100% !important; display: block !important; }
  .eyebrow--light { color: #FFD966; }
  .raffle { border-bottom: 1px solid var(--color-gray-light); }
  .raffle__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: 2.5rem;
    align-items: center;
  }
  .raffle__lead { font-size: 1.12rem; }
  .raffle__details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .raffle__details div {
    background: var(--color-white);
    border-top: 4px solid var(--color-blue-dark);
    box-shadow: var(--shadow-sm);
    padding: 1rem;
  }
  .raffle__details dt {
    color: var(--color-gray);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .raffle__details dd {
    color: var(--color-blue-dark);
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0.25rem 0 0;
    text-transform: uppercase;
  }
  .raffle__note { color: var(--color-gray); font-size: 0.9rem; }
  .raffle__art {
    background: var(--color-white);
    border: 1px solid var(--color-gray-light);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    display: block;
    overflow: hidden;
  }
  .raffle__art:hover { transform: translateY(-2px); }
  .raffle__art img { margin: 0 !important; width: 100%; }
  .leadership {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .leadership__list { list-style: none; margin: 0; padding: 0; }
  .leadership__list li { margin-bottom: 0.5rem; }
  .leadership__cta { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; }
  @media (max-width: 800px) {
    .raffle__inner { grid-template-columns: 1fr; }
    .raffle__details { grid-template-columns: 1fr; }
    .leadership { grid-template-columns: 1fr; }
  }
</style>
