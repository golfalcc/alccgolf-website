---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Rates" description="Green fees, cart rates, and guest pricing at American Legion Country Club.">
  <PageHero title="Rates" subtitle="Member and guest green fees and cart pricing." />

  <section class="section">
    <div class="container">
      <aside class="temporary-rates" aria-labelledby="temporary-rates-heading">
        <span class="temporary-rates__label">Winter Closure</span>
        <h2 id="temporary-rates-heading">2027 Rates Coming Before Reopening</h2>
        <p>The golf course closes for winter beginning November 1, 2026.
        Daily rates for the 2027 season will be posted here when they are
        finalized. Call the Pro Shop at <a href="tel:18145424343">(814) 542-4343</a>
        with questions.</p>
      </aside>

      <div class="standard-rates-heading">
        <span class="eyebrow">2026 Reference</span>
        <h2>Previous Seasonal Rates</h2>
        <p>The rates below are retained for reference and are not a promise of 2027 pricing.</p>
      </div>

      <h2>Member Cart Fees</h2>
      <table>
        <thead><tr><th>Item</th><th>Price</th></tr></thead>
        <tbody>
          <tr><td>Members — 9 Hole Cart</td><td>$10.00</td></tr>
          <tr><td>Members — 18 Hole Cart</td><td>$20.00</td></tr>
        </tbody>
      </table>

      <h2>Non-Member Fees</h2>
      <table>
        <thead><tr><th>Item</th><th>Price</th></tr></thead>
        <tbody>
          <tr><td>Weekday 9 Holes (Walking)</td><td>$12.00</td></tr>
          <tr><td>Weekday 9 Holes (with Cart)</td><td>$26.00</td></tr>
          <tr><td>Weekday 18 Holes (Walking)</td><td>$20.00</td></tr>
          <tr><td>Weekday 18 Holes (with Cart)</td><td>$36.00</td></tr>
          <tr><td>Weekend 9 Holes (Walking)</td><td>$20.00</td></tr>
          <tr><td>Weekend 9 Holes (with Cart)</td><td>$30.00</td></tr>
          <tr><td>Weekend 18 Holes (Walking)</td><td>$25.00</td></tr>
          <tr><td>Weekend 18 Holes (with Cart)</td><td>$46.00</td></tr>
          <tr><td>Weekday Tee-Time Golf Pass / Victory Book</td><td>$27.00</td></tr>
          <tr><td>Weekend Tee-Time Golf Pass / Victory Book</td><td>$41.00</td></tr>
        </tbody>
      </table>

      <h2>Cards Honored</h2>
      <ul>
        <li>American Cancer Society – Pennsylvania Golf Pass: $20.00 for 18 holes with cart</li>
        <li>Central Counties Card: $20.00 for 18 holes with cart</li>
      </ul>
      <p>Passes are excluded during tournaments unless otherwise designated
      by the Pro Shop. Active Military are admitted free with a Military ID.</p>

      <p><em>These 2026 rates are archived for reference only. Call the Pro
      Shop at (814) 542-4343 for current information.</em></p>

      <div class="cta-row">
        <a class="btn btn--red" href="/memberships">Memberships</a>
        <a class="btn btn--navy" href="/event-pricing">Event Pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cta-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; }
  .temporary-rates {
    background: var(--color-off-white);
    border: 2px solid var(--color-red);
    border-left-width: 8px;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    margin-bottom: 3rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .temporary-rates__label {
    color: var(--color-red);
    display: block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }
  .standard-rates-heading { border-bottom: 1px solid var(--color-gray-light); margin-bottom: 2rem; padding-bottom: 1rem; }
</style>
