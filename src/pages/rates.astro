---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Rates" description="Green fees, cart rates, and guest pricing at American Legion Country Club.">
  <PageHero title="Rates" subtitle="Member and guest green fees and cart pricing." />

  <section class="section">
    <div class="container">
      <aside class="temporary-rates" aria-labelledby="temporary-rates-heading">
        <span class="temporary-rates__label">Temporary Daily Rates</span>
        <h2 id="temporary-rates-heading">Adjusted Pricing Until Further Notice</h2>
        <p>Due to a chemical reaction that caused several greens to fall into disrepair, ALCC has temporarily reduced its daily golf fees. These prices are available every day until further notice.</p>
        <div class="temporary-rates__grid">
          <div>
            <h3>Nonmembers</h3>
            <p><strong>$10</strong> for 9 holes with cart</p>
            <p><strong>$20</strong> for 18 holes with cart</p>
          </div>
          <div>
            <h3>Members</h3>
            <p><strong>$5</strong> for 9 holes</p>
            <p><strong>$10</strong> for 18 holes</p>
          </div>
        </div>
        <p class="temporary-rates__note">The temporary prices above supersede the standard rates listed below. Call the Pro Shop at <a href="tel:18145424343">(814) 542-4343</a> with questions.</p>
      </aside>

      <div class="standard-rates-heading">
        <span class="eyebrow">For Reference</span>
        <h2>Standard Seasonal Rates</h2>
        <p>These standard rates are temporarily superseded by the adjusted pricing above.</p>
      </div>

      <h2>Member Cart Fees</h2>
      <table>
        <thead><tr><th>Item</th><th>Price</th></tr></thead>
        <tbody>
          <tr><td>Members — 9 Hole Cart</td><td>$10.00</td></tr>
          <tr><td>Members — 18 Hole Cart</td><td>$20.00</td></tr>
        </tbody>
      </table>

      <h2>Non-Member Fees</h2>
      <table>
        <thead><tr><th>Item</th><th>Price</th></tr></thead>
        <tbody>
          <tr><td>Weekday 9 Holes (Walking)</td><td>$12.00</td></tr>
          <tr><td>Weekday 9 Holes (with Cart)</td><td>$26.00</td></tr>
          <tr><td>Weekday 18 Holes (Walking)</td><td>$20.00</td></tr>
          <tr><td>Weekday 18 Holes (with Cart)</td><td>$36.00</td></tr>
          <tr><td>Weekend 9 Holes (Walking)</td><td>$20.00</td></tr>
          <tr><td>Weekend 9 Holes (with Cart)</td><td>$30.00</td></tr>
          <tr><td>Weekend 18 Holes (Walking)</td><td>$25.00</td></tr>
          <tr><td>Weekend 18 Holes (with Cart)</td><td>$46.00</td></tr>
          <tr><td>Weekday Tee-Time Golf Pass / Victory Book</td><td>$27.00</td></tr>
          <tr><td>Weekend Tee-Time Golf Pass / Victory Book</td><td>$41.00</td></tr>
        </tbody>
      </table>

      <h2>Cards Honored</h2>
      <ul>
        <li>American Cancer Society – Pennsylvania Golf Pass: $20.00 for 18 holes with cart</li>
        <li>Central Counties Card: $20.00 for 18 holes with cart</li>
      </ul>
      <p>Passes are excluded during tournaments unless otherwise designated
      by the Pro Shop. Active Military are admitted free with a Military ID.</p>

      <p><em>Rates are current as published by the club and may change
      seasonally — call the pro shop at (814) 542-4343 to confirm.</em></p>

      <div class="cta-row">
        <a class="btn btn--red" href="/memberships">Memberships</a>
        <a class="btn btn--navy" href="/event-pricing">Event Pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cta-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; }
  .temporary-rates {
    background: var(--color-off-white);
    border: 2px solid var(--color-red);
    border-left-width: 8px;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    margin-bottom: 3rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .temporary-rates__label {
    color: var(--color-red);
    display: block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }
  .temporary-rates__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
    margin: 1.5rem 0;
  }
  .temporary-rates__grid > div {
    background: var(--color-white);
    border-top: 4px solid var(--color-blue-dark);
    padding: 1.25rem;
  }
  .temporary-rates__grid h3 { margin-bottom: 0.75rem; }
  .temporary-rates__grid p { margin-bottom: 0.35rem; }
  .temporary-rates__grid strong { color: var(--color-red); font-size: 1.35rem; }
  .temporary-rates__note { font-weight: 600; margin-bottom: 0; }
  .standard-rates-heading { border-bottom: 1px solid var(--color-gray-light); margin-bottom: 2rem; padding-bottom: 1rem; }
  @media (max-width: 640px) { .temporary-rates__grid { grid-template-columns: 1fr; } }
</style>
