---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Card from '../components/Card.astro';

const tournaments = (await getCollection('tournaments')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Events" description="Signature tournaments and upcoming events at American Legion Country Club.">
  <PageHero title="Events" subtitle="2027 signature tournament dates are posted. The full schedule is coming soon." />

  <section class="section">
    <div class="container">
      <p>The <strong>Spring Classic</strong> will be held April 24–25, 2027,
      and the <strong>June Invitational</strong> will be held June 26–27,
      2027. Both remain on their traditional last full weekend of the
      month. The remaining 2027 tournament and outing schedule will be
      added when it is finalized.</p>
      <a class="btn btn--navy" href="/calendar">View Full Calendar</a>

      <h2 style="margin-top:2.5rem;">ALCC Major Tournaments</h2>
      <div class="grid grid--3">
        {tournaments.map((t) => (
          <Card
            title={t.data.title}
            href={`/events/${t.data.urlSlug}`}
            description={`${t.data.dates}. ${t.data.summary}`}
          />
        ))}
      </div>

      <p style="margin-top:2rem;"><em>Interested in booking ALCC as a venue
      for your own outing? Contact Barry at (814) 542-4343.</em></p>
    </div>
  </section>
</BaseLayout>
